  },
  "devDependencies": {
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
